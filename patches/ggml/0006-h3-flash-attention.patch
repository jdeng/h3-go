diff --git a/src/ggml-cuda/h3-flash-attn.cu b/src/ggml-cuda/h3-flash-attn.cu
new file mode 100644
--- /dev/null
+++ b/src/ggml-cuda/h3-flash-attn.cu
@@ -0,0 +1,91 @@
+#include "h3-flash-attn.cuh"
+#include "convert.cuh"
+#include "flash.h"
+#include "flash_fwd_kernel.h"
+
+using h3_attention_traits = Flash_fwd_kernel_traits<128, 128, 64, 4, false, false, cutlass::half_t>;
+
+static __global__ __launch_bounds__(128) void h3_attention_forward(const flash::Flash_fwd_params params) {
+    flash::compute_attn<h3_attention_traits, false, false, false, false, false, true, false, false>(params);
+}
+
+size_t ggml_cuda_h3_flash_attn_get_alloc_size(int device, const ggml_tensor * dst) {
+    const auto * query = dst->src[0];
+    const auto * keys = dst->src[1];
+    const auto * values = dst->src[2];
+    const int capability = ggml_cuda_info().devices[device].cc;
+    if (!GGML_CUDA_CC_IS_NVIDIA(capability) || capability < GGML_CUDA_CC_BLACKWELL || capability >= GGML_CUDA_CC_RUBIN ||
+            query->type != GGML_TYPE_F32 || keys->type != GGML_TYPE_F16 || values->type != GGML_TYPE_F16 ||
+            dst->type != GGML_TYPE_F32 || query->ne[0] != 128 || keys->ne[0] != 128 || values->ne[0] != 128 ||
+            query->ne[1] < 1024 || query->ne[1] != keys->ne[1] || keys->ne[1] != values->ne[1] ||
+            query->ne[2] != keys->ne[2] || keys->ne[2] != values->ne[2] ||
+            query->ne[3] != keys->ne[3] || keys->ne[3] != values->ne[3] ||
+            dst->src[3] != nullptr || dst->src[4] != nullptr ||
+            !ggml_is_contiguous(query) || !ggml_is_contiguous(keys) ||
+            !ggml_is_contiguous(values) || !ggml_is_contiguous(dst)) {
+        return 0;
+    }
+    float max_bias, softcap;
+    memcpy(&max_bias, reinterpret_cast<const float *>(dst->op_params) + 1, sizeof(float));
+    memcpy(&softcap, reinterpret_cast<const float *>(dst->op_params) + 2, sizeof(float));
+    if (max_bias != 0.f || softcap != 0.f) {
+        return 0;
+    }
+    const size_t count = ggml_nelements(query);
+    return GGML_PAD(ggml_nbytes(dst), 256) + 2 * GGML_PAD(count * sizeof(half), 256) + count / 128 * sizeof(float);
+}
+
+bool ggml_cuda_h3_flash_attn(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    if (ggml_cuda_h3_flash_attn_get_alloc_size(ctx.device, dst) == 0) {
+        return false;
+    }
+    const auto * query = dst->src[0];
+    const auto * keys = dst->src[1];
+    const auto * values = dst->src[2];
+    float scale;
+    memcpy(&scale, dst->op_params, sizeof(float));
+    auto stream = ctx.stream();
+    const int64_t count = ggml_nelements(query);
+    auto * scratch = static_cast<char *>(dst->data) + GGML_PAD(ggml_nbytes(dst), 256);
+    auto * query_half = reinterpret_cast<half *>(scratch);
+    auto * output_half = reinterpret_cast<half *>(scratch + GGML_PAD(count * sizeof(half), 256));
+    auto * logsumexp = reinterpret_cast<float *>(scratch + 2 * GGML_PAD(count * sizeof(half), 256));
+    ggml_get_to_fp16_cuda(GGML_TYPE_F32)(query->data, query_half, count, stream);
+
+    flash::Flash_fwd_params params{};
+    params.q_ptr = query_half;
+    params.k_ptr = keys->data;
+    params.v_ptr = values->data;
+    params.o_ptr = output_half;
+    params.softmax_lse_ptr = logsumexp;
+    params.b = query->ne[3];
+    params.h = query->ne[2];
+    params.h_k = params.h;
+    params.h_h_k_ratio = 1;
+    params.seqlen_q = query->ne[1];
+    params.seqlen_k = keys->ne[1];
+    params.seqlen_q_rounded = GGML_PAD(params.seqlen_q, 128);
+    params.seqlen_k_rounded = GGML_PAD(params.seqlen_k, 64);
+    params.d = params.d_rounded = 128;
+    params.total_q = params.b * params.seqlen_q;
+    params.q_row_stride = params.k_row_stride = params.v_row_stride = 128;
+    params.q_head_stride = params.k_head_stride = params.v_head_stride = int64_t(params.seqlen_q) * 128;
+    params.q_batch_stride = params.k_batch_stride = params.v_batch_stride = params.q_head_stride * params.h;
+    params.o_head_stride = 128;
+    params.o_row_stride = int64_t(params.h) * 128;
+    params.o_batch_stride = params.o_row_stride * params.seqlen_q;
+    params.scale_softmax = params.scale_softmax_rp_dropout = scale;
+    params.scale_softmax_log2 = scale * 1.4426950408889634f;
+    params.p_dropout = params.rp_dropout = 1.f;
+    params.p_dropout_in_uint8_t = 255;
+    params.window_size_left = params.window_size_right = -1;
+    params.is_seqlens_k_cumulative = true;
+
+    const dim3 blocks((params.seqlen_q + 127) / 128, params.b, params.h);
+    constexpr int shared_bytes = h3_attention_traits::kSmemSize;
+    CUDA_CHECK(cudaFuncSetAttribute(h3_attention_forward, cudaFuncAttributeMaxDynamicSharedMemorySize, shared_bytes));
+    h3_attention_forward<<<blocks, 128, shared_bytes, stream>>>(params);
+    CUDA_CHECK(cudaGetLastError());
+    ggml_get_to_fp32_cuda(GGML_TYPE_F16)(output_half, static_cast<float *>(dst->data), count, stream);
+    return true;
+}
