+static struct ggml_tensor * ggml_h3_modulation_impl(
+        struct ggml_context * ctx, struct ggml_tensor * input,
+        struct ggml_tensor * auxiliary, struct ggml_tensor * projection,
+        const int32_t * ends, const int32_t * rows, int spans,
+        int expand, int index, float epsilon, enum ggml_op op) {
+    GGML_ASSERT(input->type == GGML_TYPE_F32 && ggml_is_contiguous(input));
+    GGML_ASSERT(auxiliary->type == GGML_TYPE_F32 && ggml_is_contiguous(auxiliary));
+    GGML_ASSERT(projection->type == GGML_TYPE_F32 && ggml_is_contiguous(projection));
+    GGML_ASSERT(spans > 0 && spans <= 6 && expand > 0 && index >= 0 && index < expand);
+    GGML_ASSERT(ggml_nelements(projection) % (input->ne[0] * expand) == 0);
+    GGML_ASSERT(ends[spans - 1] == input->ne[1]);
+    int32_t params[16] = {0};
+    memcpy(params, &epsilon, sizeof(epsilon));
+    params[1] = expand;
+    params[2] = index;
+    params[3] = spans;
+    for (int span = 0; span < spans; ++span) {
+        GGML_ASSERT(ends[span] > (span == 0 ? 0 : ends[span - 1]));
+        GGML_ASSERT(rows[span] >= 0 && rows[span] < ggml_nelements(projection) / (input->ne[0] * expand));
+        params[4 + span * 2] = ends[span];
+        params[5 + span * 2] = rows[span];
+    }
+    struct ggml_tensor * result = ggml_dup_tensor(ctx, input);
+    result->op = op;
+    result->src[0] = input;
+    result->src[1] = auxiliary;
+    result->src[2] = projection;
+    ggml_set_op_params(result, params, sizeof(params));
+    return result;
+}
