+        const int32_t * ends, const int32_t * rows, int spans,
+        int expand, int shift_index, float epsilon) {
+    GGML_ASSERT(ggml_nelements(weight) == input->ne[0] && shift_index + 1 < expand && epsilon >= 0.0f);
+    return ggml_h3_modulation_impl(ctx, input, weight, projection, ends, rows, spans,
