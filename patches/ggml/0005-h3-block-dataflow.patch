+static __global__ void h3_swiglu_f32(
+        const float * base, const float * adapter, float * output, int channels, int64_t elements,
+        float base_scale, float adapter_scale) {
+    const int64_t element = int64_t(blockIdx.x) * 256 + threadIdx.x;
+    if (element >= elements) {
+        return;
+    }
+    const int64_t offset = (element / channels) * channels * 2 + element % channels;
+    const float gate = __fadd_rn(__fmul_rn(base[offset], base_scale), __fmul_rn(adapter[offset], adapter_scale));
+    const float value = __fadd_rn(__fmul_rn(base[offset + channels], base_scale),
+                                __fmul_rn(adapter[offset + channels], adapter_scale));
+    output[element] = __fmul_rn(ggml_cuda_op_silu_single(gate), value);
+}
+
+static void ggml_cuda_h3_swiglu(ggml_backend_cuda_context & context, ggml_tensor * output) {
+    const int64_t elements = ggml_nelements(output);
+    h3_swiglu_f32<<<(elements + 255) / 256, 256, 0, context.stream()>>>(
+        static_cast<const float *>(output->src[0]->data), static_cast<const float *>(output->src[1]->data),
+        static_cast<float *>(output->data), output->ne[0], elements,
+        ggml_get_op_params_f32(output, 0), ggml_get_op_params_f32(output, 1));
     CUDA_CHECK(cudaGetLastError());
 }
 
