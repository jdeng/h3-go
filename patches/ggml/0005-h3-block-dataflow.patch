+static __global__ void h3_value_layout_f16(
+        const char * input, half * output, int channels, int heads, int tokens, int64_t elements,
+        size_t head_stride, size_t token_stride, size_t batch_stride, float scale) {
+    const int64_t element = int64_t(blockIdx.x) * 256 + threadIdx.x;
+    if (element >= elements) {
+        return;
+    }
+    const int channel = element % channels;
+    const int token = (element / channels) % tokens;
+    const int head = (element / (int64_t(channels) * tokens)) % heads;
+    const int batch = element / (int64_t(channels) * tokens * heads);
+    const auto * source = reinterpret_cast<const float *>(input + head * head_stride + token * token_stride + batch * batch_stride);
+    output[element] = __float2half_rn(__fmul_rn(source[channel], scale));
+}
+
+static void ggml_cuda_h3_value_layout(ggml_backend_cuda_context & context, ggml_tensor * output) {
+    const auto * input = output->src[0];
+    const int64_t elements = ggml_nelements(output);
+    h3_value_layout_f16<<<(elements + 255) / 256, 256, 0, context.stream()>>>(
+        static_cast<const char *>(input->data), static_cast<half *>(output->data),
+        input->ne[0], input->ne[1], input->ne[2], elements,
+        input->nb[1], input->nb[2], input->nb[3], ggml_get_op_params_f32(output, 0));
