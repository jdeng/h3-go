+static void ggml_cuda_h3_modulate(ggml_backend_cuda_context & context, ggml_tensor * output) {
+    const auto * input = output->src[0];
+    h3_span_params params;
+    memcpy(&params, output->op_params, sizeof(params));
+    const int64_t elements = ggml_nelements(output);
+    if (output->op == GGML_OP_H3_RMS_MODULATE) {
+        const int64_t rows = ggml_nrows(output);
+        GGML_ASSERT(rows > 0 && rows <= INT32_MAX);
+        if (input->ne[0] < 1024) {
+            h3_rms_modulate_f32<256><<<rows, 256, 0, context.stream()>>>(
+                static_cast<const float *>(input->data), static_cast<const float *>(output->src[1]->data),
+                static_cast<const float *>(output->src[2]->data), static_cast<float *>(output->data),
+                input->ne[0], input->ne[1], params);
+        } else {
+            h3_rms_modulate_f32<1024><<<rows, 1024, 0, context.stream()>>>(
+                static_cast<const float *>(input->data), static_cast<const float *>(output->src[1]->data),
+                static_cast<const float *>(output->src[2]->data), static_cast<float *>(output->data),
+                input->ne[0], input->ne[1], params);
+        }
+    } else {
+        h3_gated_residual_f32<<<(elements + 255) / 256, 256, 0, context.stream()>>>(
+            static_cast<const float *>(input->data), static_cast<const float *>(output->src[1]->data),
+            static_cast<const float *>(output->src[2]->data), static_cast<float *>(output->data),
+            input->ne[0], input->ne[1], elements, params);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
