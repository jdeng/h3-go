+struct h3_span_params {
+    float epsilon;
+    int32_t expand;
+    int32_t index;
+    int32_t spans;
+    int32_t boundaries[12];
+};
+
+static_assert(sizeof(h3_span_params) == 64, "H3 span parameters must fit GGML op_params");
+
+static __device__ int h3_modulation_row(int token, h3_span_params params) {
+    for (int span = 0; span < params.spans; ++span) {
+        if (token < params.boundaries[span * 2]) {
+            return params.boundaries[span * 2 + 1];
+        }
+    }
+    return 0;
+}
+
+template <int BlockSize>
+static __global__ void h3_rms_modulate_f32(
+        const float * input, const float * weight, const float * projection, float * output,
+        int channels, int tokens, h3_span_params params) {
+    const int token = blockIdx.x % tokens;
+    const int modulation_row = h3_modulation_row(token, params);
+    const int64_t offset = int64_t(blockIdx.x) * channels;
+    const int64_t modulation_offset = (int64_t(modulation_row) * params.expand + params.index) * channels;
+    float sum = 0.0f;
+    for (int channel = threadIdx.x; channel < channels; channel += BlockSize) {
+        const float value = input[offset + channel];
+        sum += value * value;
+    }
+    __shared__ float partial[BlockSize / 32];
+    sum = block_reduce<block_reduce_method::SUM, BlockSize>(sum, partial);
+    const float inverse_rms = rsqrtf(sum / channels + params.epsilon);
+    for (int channel = threadIdx.x; channel < channels; channel += BlockSize) {
+        const float normalized = __fmul_rn(__fmul_rn(input[offset + channel], inverse_rms), weight[channel]);
+        const float scaled = __fmul_rn(normalized, projection[modulation_offset + channels + channel]);
+        output[offset + channel] = __fadd_rn(__fadd_rn(normalized, scaled), projection[modulation_offset + channel]);
+    }
+}
+
+static __global__ void h3_gated_residual_f32(
+        const float * input, const float * update, const float * projection, float * output,
+        int channels, int tokens, int64_t elements, h3_span_params params) {
+    const int64_t element = int64_t(blockIdx.x) * 256 + threadIdx.x;
+    if (element >= elements) {
+        return;
+    }
+    const int channel = element % channels;
+    const int token = (element / channels) % tokens;
+    const int modulation_row = h3_modulation_row(token, params);
+    const int64_t modulation_offset = (int64_t(modulation_row) * params.expand + params.index) * channels;
+    output[element] = __fadd_rn(input[element], __fmul_rn(update[element], projection[modulation_offset + channel]));
+}
