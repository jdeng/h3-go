diff --git a/src/ggml-cuda/h3-fusion.cuh b/src/ggml-cuda/h3-fusion.cuh
new file mode 100644
--- /dev/null
+++ b/src/ggml-cuda/h3-fusion.cuh
@@ -0,0 +1,46 @@
+#ifndef GGML_CUDA_H3_FUSION_CUH
+#define GGML_CUDA_H3_FUSION_CUH
+
+static __global__ void h3_rms_rope_f32(
+        const char * input, const float * weight, const float * position, float * output,
+        int heads, int tokens, int pairs, size_t head_stride, size_t token_stride,
+        size_t batch_stride, float epsilon) {
+    const int channel = threadIdx.x;
+    const int head = blockIdx.x % heads;
+    const int token = (blockIdx.x / heads) % tokens;
+    const int batch = blockIdx.x / (heads * tokens);
+    const float * row = reinterpret_cast<const float *>(input + head * head_stride +
+                                                       token * token_stride + batch * batch_stride);
+    float sum = channel < 128 ? row[channel] * row[channel] : 0.0f;
+    __shared__ float partial[8];
+    sum = block_reduce<block_reduce_method::SUM, 256>(sum, partial);
+    const float scale = rsqrtf(sum / 128.0f + epsilon);
+    if (channel < 128) {
+        float value = __fmul_rn(__fmul_rn(row[channel], scale), weight[channel]);
+        if (channel < pairs * 2) {
+            const int pair = channel % pairs;
+            const float first = __fmul_rn(__fmul_rn(row[pair], scale), weight[pair]);
+            const float second = __fmul_rn(__fmul_rn(row[pair + pairs], scale), weight[pair + pairs]);
+            const int64_t position_offset = (int64_t(token) * pairs + pair) * 4 + (channel / pairs) * 2;
+            value = __fadd_rn(__fmul_rn(first, position[position_offset]),
+                             __fmul_rn(second, position[position_offset + 1]));
+        }
+        output[((int64_t(batch) * heads + head) * tokens + token) * 128 + channel] = value;
+    }
+}
+
+static void ggml_cuda_h3_rms_rope(ggml_backend_cuda_context & context, ggml_tensor * output) {
+    const auto * input = output->src[0];
+    const auto * weight = output->src[1];
+    const auto * position = output->src[2];
+    const int64_t rows = input->ne[1] * input->ne[2] * input->ne[3];
+    GGML_ASSERT(rows > 0 && rows <= INT32_MAX);
+    h3_rms_rope_f32<<<rows, 256, 0, context.stream()>>>(
+        static_cast<const char *>(input->data), static_cast<const float *>(weight->data),
+        static_cast<const float *>(position->data), static_cast<float *>(output->data),
+        input->ne[1], input->ne[2], position->ne[2], input->nb[1], input->nb[2], input->nb[3],
+        ggml_get_op_params_f32(output, 0));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+#endif
