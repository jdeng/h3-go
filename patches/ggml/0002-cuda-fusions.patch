+#ifndef GGML_CUDA_COMFY_INT8_FUSION_CUH
+#define GGML_CUDA_COMFY_INT8_FUSION_CUH
+
+#ifdef GGML_CUDA_COMFY_INT8
+extern "C" bool launch_cutlass_int8_dequant(
+    const void *, const void *, const void *, const void *, const void *, void *,
+    int64_t, int64_t, int64_t, int, cudaStream_t);
+
+static thread_local ggml_cuda_pool_alloc<char> * comfy_int8_workspace = nullptr;
+
+extern "C" void * comfy_cutlass_external_workspace(size_t size, cudaStream_t stream);
+
+extern "C" void * comfy_cutlass_external_workspace(size_t size, cudaStream_t stream) {
+    GGML_UNUSED(stream);
+    if (size == 0) {
+        return nullptr;
+    }
+    GGML_ASSERT(comfy_int8_workspace != nullptr);
+    if (comfy_int8_workspace->get() == nullptr) {
+        return comfy_int8_workspace->alloc(size);
+    }
+    return comfy_int8_workspace->actual_size >= size ? comfy_int8_workspace->get() : nullptr;
+}
+
+struct ggml_cuda_comfy_int8_scope {
+    ggml_cuda_pool_alloc<char> workspace;
+    ggml_cuda_pool_alloc<char> * previous;
+
+    explicit ggml_cuda_comfy_int8_scope(ggml_cuda_pool & pool) : workspace(pool), previous(comfy_int8_workspace) {
+        comfy_int8_workspace = &workspace;
+    }
+
+    ~ggml_cuda_comfy_int8_scope() {
+        comfy_int8_workspace = previous;
+    }
+};
+
+static bool ggml_cuda_comfy_int8_eligible(int device, int64_t rows, int64_t columns, int64_t inner) {
+    const bool projection = inner == 4096 && (columns == 4096 || columns == 24576);
+    const bool down = inner == 12288 && columns == 4096;
+    return ggml_cuda_info().devices[device].cc == 1200 &&
+           rows >= 4096 && rows <= 65535 && (projection || down);
+}
+#endif
+
+#endif
